#!/usr/bin/env php
<?php

/**
 * Prefer Composer's phpunit/phpunit so we do not run simple-phpunit's nested Composer
 * install (bin/.phpunit/...) which can pin platform PHP to 7.0.99 and break resolution.
 */
$projectDir = dirname(__DIR__);
$composerPhpunit = $projectDir.'/vendor/phpunit/phpunit/phpunit';

if (is_file($composerPhpunit)) {
    require $composerPhpunit;
    return;
}

if (!file_exists($projectDir.'/vendor/symfony/phpunit-bridge/bin/simple-phpunit')) {
    fwrite(STDERR, "PHPUnit not found. Run: composer install\n");
    exit(1);
}

if (false === getenv('SYMFONY_PHPUNIT_VERSION')) {
    putenv('SYMFONY_PHPUNIT_VERSION=6.5');
}
if (false === getenv('SYMFONY_PHPUNIT_REMOVE')) {
    putenv('SYMFONY_PHPUNIT_REMOVE=');
}
if (false === getenv('SYMFONY_PHPUNIT_DIR')) {
    putenv('SYMFONY_PHPUNIT_DIR='.$projectDir.'/bin/.phpunit');
}

require $projectDir.'/vendor/symfony/phpunit-bridge/bin/simple-phpunit';
